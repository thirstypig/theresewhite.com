<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/field-notes/draft.sh every Thursday at 9:00 a.m. The script
  itself decides whether this is the Thursday before a first Tuesday.
  If the Mac is asleep at 9:00, macOS runs it when the Mac wakes.
  Install:   cp com.theresewhite.fieldnotes.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.theresewhite.fieldnotes.plist
  Remove:    launchctl bootout gui/$(id -u)/com.theresewhite.fieldnotes
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.theresewhite.fieldnotes</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/jameschang/Projects/theresewhite.com/scripts/field-notes/draft.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/jameschang/Library/Logs/field-notes.log</string>
  <key>StandardErrorPath</key><string>/Users/jameschang/Library/Logs/field-notes.log</string>
</dict>
</plist>
