# Public URL of THIS deployment. Anything other than https://www.theresewhite.com
# is treated as staging: robots.txt becomes "Disallow: /", every page gets a
# noindex tag, and no sitemap is emitted. That keeps the staging copy from
# competing with the live Wix site in search.
NEXT_PUBLIC_SITE_URL=https://theresewhite.bahtzang.com

# Contact form endpoint.
#
# This is a static site, so there is no server to receive a POST. Point this at
# a form service that accepts a plain HTML form submission — Formspree
# (https://formspree.io) and Web3Forms (https://web3forms.com) both have free
# tiers and need no JavaScript.
#
# Leave it unset and the contact page shows phone and email instead of a form
# that silently goes nowhere.
NEXT_PUBLIC_FORM_ENDPOINT=

# Microsoft Clarity. Falls back to the hardcoded project ID if unset.
NEXT_PUBLIC_CLARITY_ID=xxajqpw2g7

# Google Analytics 4 measurement ID. Falls back to the hardcoded ID if unset.
NEXT_PUBLIC_GA_ID=G-4QVRMZJVWS

# Note: both analytics tools are gated behind the cookie consent banner and
# only load in production builds after a visitor accepts.
