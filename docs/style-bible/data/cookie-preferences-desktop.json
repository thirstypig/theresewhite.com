 "texts": [
  {
   "role": "a",
   "region": "header",
   "y": 40,
   "text": "About Therese",
   "size": "19px",
   "family": "forum",
   "align": "start"
  },
  {
   "role": "a",
   "region": "header",
   "y": 40,
   "text": "Endorsements",
   "size": "19px",
   "family": "forum",
   "align": "start"
  },
  {
   "role": "a",
